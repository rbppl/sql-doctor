# Copy to .env for local development. Never commit actual credentials.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/developer_doctor
FRONTEND_URL=http://localhost:5173

# GitHub OAuth (optional for local analyzer-only testing)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=

# Stripe subscriptions (optional until billing is enabled)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_DAILY_LIMIT=1000

# Optional protected Prometheus endpoint
MONITORING_BEARER_TOKEN=
